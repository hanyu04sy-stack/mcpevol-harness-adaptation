{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hanyu04sy-stack/mcpevol-harness-adaptation/raw/main/schemas/task-list.schema.json",
  "title": "MCPEvol fixed task list",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["idx", "question", "tool_calls", "servers"],
    "properties": {
      "idx": {"type": "integer", "minimum": 0},
      "question": {"type": "string", "minLength": 1},
      "tool_calls": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool_name", "parameters"],
          "properties": {
            "tool_name": {"type": "string", "minLength": 1},
            "parameters": {"type": "object"}
          }
        }
      },
      "servers": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "response": {"type": "string"},
      "answer": {"type": "string"}
    },
    "additionalProperties": true
  }
}
